--- NakaComponents.kt
+++ NakaComponents.kt
@@
+import androidx.compose.foundation.gestures.detectDragGestures
+import androidx.compose.ui.input.pointer.pointerInput
+import androidx.compose.ui.unit.IntOffset
@@
-SmallFloatingActionButton(onClick = onClick, modifier = modifier.size(48.dp), ...)
+BoxWithConstraints(modifier.fillMaxSize()) {
+    var x by rememberSaveable { mutableIntStateOf(12) }
+    var y by rememberSaveable { mutableIntStateOf(-1) }
+    LaunchedEffect(maxWidth, maxHeight) {
+        if (y < 0) y = maxHeight.toPx().roundToInt() - 64.dp.toPx().roundToInt()
+    }
+    SmallFloatingActionButton(
+        onClick = onClick,
+        modifier = Modifier.offset { IntOffset(x, y.coerceAtLeast(0)) }
+            .size(48.dp)
+            .pointerInput(maxWidth, maxHeight) {
+                detectDragGestures { _, amount ->
+                    x = (x + amount.x.roundToInt()).coerceIn(0, maxX)
+                    y = (y + amount.y.roundToInt()).coerceIn(0, maxY)
+                }
+            },
+        ...
+    ) {
+        Icon(Icons.Default.ChatBubble,
+            contentDescription = "Open chatbot. Drag to move.")
+    }
+}

The actual implementation calculates maxX/maxY from the available content
size, keeping the shortcut inside the screen and above the scaffold insets.

